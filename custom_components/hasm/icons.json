{
  "entity": {
    "binary_sensor": {
      "connectivity": { "default": "mdi:lan-connect" },
      "backup_problem": { "default": "mdi:alert-circle" },
      "backup_in_progress": { "default": "mdi:progress-upload" }
    },
    "sensor": {
      "core_version":       { "default": "mdi:home-assistant" },
      "os_version":         { "default": "mdi:chip" },
      "supervisor_version": { "default": "mdi:shield-home" },
      "updates_available":  { "default": "mdi:package-up" },
      "error_count":        { "default": "mdi:alert-circle" },
      "backup_size":           { "default": "mdi:database" },
      "backup_last_full":      { "default": "mdi:backup-restore" },
      "backup_count":          { "default": "mdi:database-outline" },
      "backup_last_completed": { "default": "mdi:backup-restore" },
      "backup_next":           { "default": "mdi:clock-outline" },
      "cpu_usage":             { "default": "mdi:cpu-64-bit" },
      "memory_usage":          { "default": "mdi:memory" },
      "disk_usage":            { "default": "mdi:harddisk" }
    },
    "button": {
